# Copy this file to `.env` and adjust as needed. `.env` itself is gitignored.

# --- Django ---
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (Postgres) ---
DB_NAME=honeychain
DB_USER=honeychain
DB_PASSWORD=honeychain_dev_pw
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Auth ---
JWT_SECRET=change-me-dev-secret
JWT_EXP_HOURS=24

# --- Blockchain (local Hardhat node acting as the EVM-compatible testnet) ---
# To point at a public testnet later (e.g. Sepolia), just change these three
# values -- no code changes required.
WEB3_RPC_URL=http://127.0.0.1:8545
# Hardhat's well-known, publicly documented default Account #0 dev key.
# Never use this key for anything holding real value.
RELAYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
CONTRACT_ARTIFACT_PATH=../contracts/deployments/localhost.json

# --- Public URLs used to build absolute links (QR target, QR image URL) ---
# NOTE: use 127.0.0.1, not "localhost", for PUBLIC_BASE_URL when the Flutter
# client is served via `flutter run` (debug web-server/chrome). Flutter's
# debug tooling (DWDS) only reliably attaches when the page is loaded from
# the exact host it reports as serving on; opening the same app at
# "localhost:8080" instead of "127.0.0.1:8080" in debug mode hangs on a
# blank/black screen. This only affects `flutter run`'s debug dev server --
# a `flutter build web` production build has no DWDS and isn't affected.
PUBLIC_BASE_URL=http://127.0.0.1:8080
BACKEND_BASE_URL=http://localhost:8000

# --- DigiLocker (FSSAI license verification on an apiary) ---
# Mocked by default -- there is no real aggregator account for this MVP.
# To point at a real one (e.g. Setu, Sandbox.co.in) later: set this to
# False and fill in the client id/secret below. No code changes required.
DIGILOCKER_USE_MOCK=True
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
